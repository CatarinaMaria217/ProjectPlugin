<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pré-visualização das alterações"
        Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabela -->
        <DataGrid x:Name="AlteracoesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Grid.Row="0"
                  Margin="0 0 0 10"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo"
                                    Binding="{Binding Tipo}"
                                    Width="200"/>

                <DataGridTextColumn Header="Keynote"
                                    Binding="{Binding Keynote}"
                                    Width="100"/>

                <DataGridTextColumn Header="Descrição Atual"
                                    Binding="{Binding Atual}"
                                    Width="*"/>

                <DataGridTextColumn Header="Nova Descrição"
                                    Binding="{Binding Novo}"
                                    Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- Botões -->
        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

        <Button x:Name="VoltarBtn"
            Content="Voltar"
            Width="120"
            Height="32"
            Margin="0 0 10 0"/>

        <Button x:Name="AplicarBtn"
            Content="Aplicar"
            Width="120"
            Height="32"
            Margin="0 0 10 0"/>

        <Button x:Name="CancelarBtn"
            Content="Cancelar"
            Width="120"
            Height="32"/>
        </StackPanel>

    </Grid>
</Window>