<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Base de Dados Airtable"
        Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid   x:Name="TabelaAirtable"
                    AutoGenerateColumns="False"
                    Grid.Row="0"
                    Margin="0 0 0 10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="150"/>
                <DataGridTextColumn Header="Keynote" Binding="{Binding Keynote}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="AdicionarBtn"
                    Content="Adicionar"
                    Width="120"
                    Height="32"
                    Margin="0 0 10 0"/>

            <Button x:Name="RemoverBtn"
                    Content="Remover"
                    Width="120"
                    Height="32"
                    Margin="0 0 10 0"/>

            <Button x:Name="GuardarBtn"
                    Content="Guardar"
                    Width="120"
                    Height="32"
                    Margin="0 0 10 0"/>

            <Button x:Name="VoltarBtn"
                    Content="Voltar"
                    Width="120"
                    Height="32"/>
        </StackPanel>

    </Grid>
</Window>
